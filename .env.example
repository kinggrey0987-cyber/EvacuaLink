# ==============================================================================
# EvacuaLink Environment Configuration Template (.env)
# ==============================================================================
# COPY THIS FILE TO '.env' AND FILL IN YOUR ENVIRONMENT-SPECIFIC CREDENTIALS.
# NEVER COMMIT YOUR REAL '.env' FILE TO VERSION CONTROL!
# ==============================================================================

# Security Settings
# Generate a unique key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-random-secret-key-here-do-not-use-in-production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Set to True when running behind HTTPS in production
SECURE_SSL_REDIRECT=False

# PostgreSQL Database Configuration
DB_NAME=evacualink_db
DB_USER=evacualink_user
DB_PASSWORD=your_strong_database_password
DB_HOST=localhost
DB_PORT=5432

# Google Maps API Key (Ensure HTTP referrer / IP restrictions are configured in Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SMTP / Email Configuration for 2FA OTP & Notifications
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
